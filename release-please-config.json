{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bootstrap-sha": "62f1fa793d58fc8c6a05265cc51e0b56393a16d0",
  "include-component-in-tag": true,
  "separate-pull-requests": true,
  "pull-request-title-pattern": "chore${scope}: release ${component} ${version}",
  "exclude-merges": true,
  "packages": {
    "transports/daily": {
      "component": "react-native-daily-transport",
      "package-name": "@pipecat-ai/react-native-daily-transport",
      "changelog-path": "CHANGELOG.md"
    },
    "transports/smallwebrtc": {
      "component": "react-native-small-webrtc-transport",
      "package-name": "@pipecat-ai/react-native-small-webrtc-transport",
      "changelog-path": "CHANGELOG.md"
    },
    "libs/daily-media-manager": {
      "component": "react-native-daily-media-manager",
      "package-name": "@pipecat-ai/react-native-daily-media-manager",
      "changelog-path": "CHANGELOG.md"
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "revert", "section": "Reverts" },
    { "type": "chore", "section": "Miscellaneous Chores" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "style", "section": "Styles", "hidden": true },
    { "type": "refactor", "section": "Code Refactoring", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build System", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true }
  ]
}
